# ============================================================================
#  GLM-Free-API configuration
#  Copy this file to `.env` and edit — or just run start.sh / start.bat
#  and one will be created for you. Every value is optional; real
#  environment variables always override .env values.
# ============================================================================

# ── Z.AI account token(s) ──────────────────────────────────────────────────
# A JWT from chat.z.ai. Multi-account: separate with commas — the pool
# round-robins between them and transparently fails over on 429 rate limits.
#   How to get one:
#     1. Log in at https://chat.z.ai
#     2. Press F12 → Console → type: localStorage.getItem('token')
#     3. Copy the long string (without quotes)
# Leave empty for guest mode (glm-5.3-flash only, no vision).
ZAI_TOKENS=

# (Legacy single-token variable — ZAI_TOKENS wins when both are set.)
# ZAI_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# The key your clients must send (Authorization: Bearer <key> / x-api-key).
# CHANGE THIS if you expose the server beyond localhost!
AUTH_TOKEN=Waguri

# ── Multi-account tuning ───────────────────────────────────────────────────
# First 429 cooldown in seconds; consecutive 429s double it (cap 30 min).
ACCOUNT_COOLDOWN_BASE=60
# How long a request waits in the queue when EVERY account is rate-limited
# or dead, before a 503 is returned (0 = wait forever).
ACCOUNT_QUEUE_TIMEOUT=120

# ── Agent mode (tool calling for agents frameworks) ─────────────────────────
# Translates OpenAI/Anthropic tools into Z.AI prompts and rewrites the
# model's <<<TOOL_CALL>>> blocks back into native tool_calls / tool_use.
AGENT_MODE=false
AGENT_MODE_VARIANT=modern

# ── Session pool ────────────────────────────────────────────────────────────
# Pre-made Z.AI chat sessions kept ready (0 = legacy sync mode).
SESSION_POOL_SIZE=5
SESSION_ACQUIRE_TIMEOUT=10
